# Copie para .env.local (desenvolvimento) e cadastre as mesmas na Vercel
# (Project Settings > Environment Variables).

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase > Project Settings > API > service_role (secret).
# SO NO SERVIDOR: nunca use o prefixo NEXT_PUBLIC_ nesta chave.
# Usada para criar logins e redefinir senhas (tela Usuarios e acessos).
SUPABASE_SERVICE_ROLE_KEY=

# IA da pagina Resultados (opcional)
OPENAI_API_KEY=
